{
  "name": "qq-bot-cf",
  "version": "3.15.0",
  "description": "零服务器、零运行时依赖的 QQ 机器人：跑在 Cloudflare Workers + Durable Objects 上，接入 QQ 开放平台，任意 OpenAI 兼容模型，自带可视化管理后台。",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "node scripts/dev.mjs",
    "preview:home": "node scripts/preview.mjs",
    "tail": "wrangler tail",
    "seed:memes": "node scripts/memes.mjs --local"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
